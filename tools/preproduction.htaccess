# Install as .htaccess ONLY inside the new /preproduccion/ directory.
# These paths are based on the existing hosting account; verify them over SSH.
Options -Indexes
DirectoryIndex index.php index.html

# Keep the existing Apache Basic credentials; never copy .htpasswd into Git.
AuthType Basic
AuthName ByPassword
AuthUserFile /home/soloviajesdelujo/www/eslogin/.htpasswd
AuthGroupFile /dev/null
Require valid-user

SetEnv SVL_ENV staging
SetEnv SVL_BASE_PATH /preproduccion
SetEnv SVL_CONFIG_FILE /home/soloviajesdelujo/svl-private/preproduccion.php
SetEnv SVL_MAIL_CAPTURE_DIR /home/soloviajesdelujo/svl-private/preprod-mail

# Require these Apache modules. Failing closed is preferable to a public staging.
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
Header always set Cache-Control "no-store, private"
Header always set Content-Security-Policy "default-src 'self' data:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:config|tools|include|pspdevel|lists)(?:/|$) - [F,L,NC]
RewriteRule \.(?:log|sql(?:\.(?:gz|bz2|xz))?|bak(?:\..*)?|eml|ini|env|cnf)$ - [F,L,NC]

# Preproduction permits the new intake forms and read-only catalogue filters.
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST)$
RewriteRule ^ - [R=405,L]
RewriteCond %{REQUEST_METHOD} =POST
RewriteRule ^(?!(?:confirmacion|registro)\.php$|eslogin/(?:admin_especialidad_visul|admin_news_visul|admin_news_agencias_visul|admin_copiarNews_add)\.php$) - [R=405,L]

# Do not execute historical save/delete/export/campaign endpoints in staging.
RewriteRule ^(?!(?:index|contacto|ofertas-exclusivas|confirmacion|registro)\.php$|destinos/[^/]+/destinos-[^/]+\.php$|viajes/[^/]+/(?:viaje|viajes)-[^/]+\.php$|eslogin/(?:index|formularios|admin_destinos_add|admin_destinos_visul|admin_destinos_modif|admin_especialidad_add|admin_especialidad_visul|admin_especialidad_modif|admin_news_add|admin_news_visul|admin_news_modif|admin_news_agencias_add|admin_news_agencias_visul|admin_news_agencias_modif|admin_lanza_add|admin_lanza_visul|admin_lanza_modif|admin_copiarNews_add)\.php$).*\.php(?:/|$) - [F,L,NC]

<FilesMatch "^(?:config(?:\.example)?\.php|info\.php)$">
    Require all denied
</FilesMatch>

<IfModule php_module>
    php_flag short_open_tag On
</IfModule>
